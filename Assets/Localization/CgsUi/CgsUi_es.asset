    - rid: 7133309421012649727
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"No se pudo iniciar la conexi\xF3n multijugador.\",\"status\":\"machine\",\"sourceHash\":\"d32f8634775ef07ef5fc3b63bd7b8511cf22010839181006eb1d2051c4b7f806\",\"provenance\":{\"method\":\"Codex
