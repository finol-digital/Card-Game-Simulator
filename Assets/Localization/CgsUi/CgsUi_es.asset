    - rid: 7133309421595918980
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"\xA1Barajado!\",\"status\":\"machine\",\"sourceHash\":\"ed0a9af0c02cb2334fac8a0e5528d840d3cbe42f34550d53571560743a933b1d\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595918981
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"\xBFJugar {names}?\",\"status\":\"machine\",\"sourceHash\":\"68fb58faf8636f46a80ae89602fbece3e98cb53dcbf6eecaddcf0d9b69a601ef\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595918982
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"\xA1No se encontraron im\xE1genes! \xBFLa carpeta
          contiene im\xE1genes {extension}?\",\"status\":\"machine\",\"sourceHash\":\"aa36f38c5838d046810ce7f1ef58898ab6536d32914e8bffae71e7b883c207ca\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595918983
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Importando {setName}...","status":"machine","sourceHash":"e6e3a80ef2c9706d54487a68e5b769d5444c580920614b06d9c13518a3e6b2bd","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421595919270
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Seleccionar carta: Clic izquierdo o {move}.\\nMover
          carta: Arrastra con el bot\xF3n izquierdo o usa {page} con una carta seleccionada.\\nDesplazar:
          Arrastra con el bot\xF3n central o May\xFAs+bot\xF3n izquierdo, o usa {page}.\\nZoom:
          Ctrl+rueda, o pulsa {toggle} para activar el zoom con {page}.\\nGirar:
          Ctrl+arrastrar con el bot\xF3n derecho, o pulsa {toggle} para activar el
          giro con {page}.\",\"status\":\"machine\",\"sourceHash\":\"fdafb77ffa0cd274a994e7561ae0efce6b4696dd4ff57f3ded6bf5881f8eaefc\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919271
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Seleccionar carta: Toca una carta.\\nVer carta:
          Mant\xE9n pulsada una carta para ampliarla.\\nMover carta: Arr\xE1strala
          con un dedo.\\nDesplazar: Arrastra el \xE1rea de juego con dos dedos.\\nZoom:
          Pellizca con dos dedos.\\nGirar: Gira con dos dedos si la rotaci\xF3n est\xE1
          activada.\",\"status\":\"machine\",\"sourceHash\":\"8cd61d7150b526f4c683276db7e794318884368e3ccf83ec332813dcd398d40d\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919272
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Contador: {value}","status":"machine","sourceHash":"c5675b5a6455c2ca233e27a68e14d77623dae5be8d57ebf69b56a5db48b5bd0b","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421595919273
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Valor: {value} / M\xE1x.: {max}\",\"status\":\"machine\",\"sourceHash\":\"fbfac67ab035dabf7bd12836a36812c49de366d1fc39f1cdd5666b72487c60aa\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919274
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"El navegador no pudo copiar el texto. Int\xE9ntalo
          desde una p\xE1gina HTTPS en un navegador compatible y comprueba los permisos
          del portapapeles.\",\"status\":\"machine\",\"sourceHash\":\"6cf35631d7b766f365c42ee63a8839394ecbb106db018d6ac42be6587604e6fb\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919275
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Se cancel\xF3 o no se complet\xF3 el uso compartido.\",\"status\":\"machine\",\"sourceHash\":\"b2eac93fb69971c61fe3389cb6d8940a42f01383a65bff494661df3a12adea4b\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919276
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Copiado al portapapeles.","status":"machine","sourceHash":"cda98707b1a1fbbbe00d30b4a3a7e3d58dde6dfc18135788a13d7389b301072f","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421595919277
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"No se pudo copiar al portapapeles. Int\xE9ntalo
          de nuevo.\",\"status\":\"machine\",\"sourceHash\":\"d5a2d95e0c19fcc0d2340e70307aae6bc0f3c46ad34ed35b9d7563a8774743fd\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919278
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"No se pudo confirmar la copia. Prueba a pegar para
          comprobarlo o vuelve a copiar.","status":"machine","sourceHash":"bb1dc1527229f23ae387371aa5fd8ad88f52b8dd07628ed26cd87e9049c5a700","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421595919279
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"El texto de este mazo se ha copiado al portapapeles.","status":"machine","sourceHash":"759c0a0d827331d2b4b1686b9d1f785656ee6a8cae900c7bd1350ec179b74238","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421595919280
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Destino seleccionado. Comprueba all\xED si se
          comparti\xF3 o copi\xF3.\",\"status\":\"machine\",\"sourceHash\":\"eb3f6505ec2a8b8c2855caa3d54c05172f5ffa0c1f14d6e661e37a52ae94232b\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919281
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"No hay texto para copiar o compartir.","status":"machine","sourceHash":"cc01f4d7753ebfc4e9841cd67af5f40c6503c19319e616a804d10573949b35f2","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421595919282
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"No se pudo abrir la opci\xF3n de compartir. Int\xE9ntalo
          de nuevo.\",\"status\":\"machine\",\"sourceHash\":\"79e37518e7b4bd4034f8e9844735c4921bf394f24f4daa4906c8a0310f724beb\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919283
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"No se pudo preparar el archivo para compartir.
          Int\xE9ntalo de nuevo.\",\"status\":\"machine\",\"sourceHash\":\"77db2fbf049a38f3c79356df057bb63492ccd8a0bac5316de453dee641755464\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919284
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"No se encontr\xF3 el archivo para compartir.
          Exp\xF3rtalo de nuevo y reintenta.\",\"status\":\"machine\",\"sourceHash\":\"bcc2d484d49fdc8c48b94074fd63e6dbcd431b1b2565154114d8b1d2be899c92\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919285
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"ID/IP de la sala copiado al portapapeles.","status":"machine","sourceHash":"c91b811b49a2fe49fdaedbe05aa28c6eda0460e583c6517b349877b9737ff156","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421595919286
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Compartir no est\xE1 disponible en esta plataforma.\",\"status\":\"machine\",\"sourceHash\":\"d6c9ecb4060b5e92f4d68636267c5717617cd30f608d65acf4552f73590060af\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919287
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Se cerr\xF3 la opci\xF3n de compartir. No se
          pudo confirmar si el contenido se comparti\xF3 o copi\xF3.\",\"status\":\"machine\",\"sourceHash\":\"45ce66249278db915687842739719753130c178e5c3a23af786b47082f645dbf\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919288
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"\xA1Bienvenido a CGS!\\nEl sitio web de CGS tiene
          gu\xEDas y recursos para nuevos usuarios.\\n\xBFIr al sitio web de CGS?\",\"status\":\"machine\",\"sourceHash\":\"6ebc31ac05e2fe242d8efb95bf836827997ff3eb24af91dfb68a52de41006641\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919289
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"\xA1Bienvenido a CGS!\\nEsta versi\xF3n m\xF3vil
          complementa la versi\xF3n para PC de CGS, disponible en el sitio web de
          CGS.\\n\xBFIr al sitio web de CGS?\",\"status\":\"machine\",\"sourceHash\":\"7b4d3ea637051f0761b5897e0d4e30858dac7559a3f81a1530d0b3409307b312\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309422095302684
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"#Pega aqu\xED el c\xF3digo del mazo\",\"status\":\"machine\",\"sourceHash\":\"8ff58d46843bbda8a99b5e18968d1b67f8273d16db05f72f25b374da5b07f9dc\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309422095302685
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"//En cada l\xEDnea, introduce:\\n//<Cantidad>
          <Nombre de carta>\\n//Por ejemplo:\\n4 Super Awesome Card\\n3 Less Awesome
          Card I Still Like\\n1 Card That Is Situational\",\"status\":\"machine\",\"sourceHash\":\"fd707523743e8eb5e2bbbcc2fe1138d175e0112b484b6df4dc372eb50fb9694e\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309422095302686
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"### Instrucciones\\n#En cada l\xEDnea, introduce:\\n#<Cantidad>
          <Nombre de carta>\\n#Por ejemplo:\\n4 Super Awesome Card\\n3 Less Awesome
          Card I Still Like\\n1 Card That Is Situational\",\"status\":\"machine\",\"sourceHash\":\"270629432bf2d3111509709bab831e007426cf604edd8bd6db7aec6024377d2e\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309422095302687
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"#En cada l\xEDnea, introduce <ID de carta>\\n#Se
          recomienda copiar y pegar\",\"status\":\"machine\",\"sourceHash\":\"43e1f3c13cb204cd956c26e2880c4f90c1fc0f2d74de517cf7479efe1c2e2950\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309422095302688
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"La imagen de {name} ({id}) es demasiado grande.
          Elimina la carta, comprime la imagen con una herramienta como https://www.iloveimg.com/compress-image
          y vuelve a importarla.","status":"machine","sourceHash":"5c57d9f839f6d60e2e3eaa2a3ddb1f230a241406d1e831a3db5883508d228dd6","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309422095302689
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Aviso: el tipo de imagen no coincide con {extension}.","status":"machine","sourceHash":"57913e896fdf4a85f3a3feb37c3e14f33e31bbed9e7335f47a1a3e86ae94e3fe","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309422095302690
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
