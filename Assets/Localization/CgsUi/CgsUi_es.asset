    - rid: 7133309421012648800
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Explorar cartas.","status":"machine","sourceHash":"1102a5d24c129fce0ffad84f9df7deb651d47bee5e47b7eb44faff9c17951cc9","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648801
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Elegir la primera opci\xF3n.\",\"status\":\"machine\",\"sourceHash\":\"a6e1ffc5e1b18699ca59d2c39910692764055c26a49e5089a7f10e7bb0fdd93f\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012648802
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Elegir la segunda opci\xF3n.\",\"status\":\"machine\",\"sourceHash\":\"c9934b2e58da033c699e7848eb6e5cc7b5f3d4120bece3ae7490eb6d5fc8f069\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012648803
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Editar mazos.","status":"machine","sourceHash":"1c4e496051ba46c81de6b6dfbe60746356dd11b0578f6dc35bcf130335d82b02","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648804
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Crea y comparte. Consulta el tutorial en el sitio
          de CGS.","status":"machine","sourceHash":"e6f0865109bb9538e7584b1016bf1ef56625a7792ef846dd71a6f736bd078cc5","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648805
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"N\xFAmero de caras de cada dado al crearlo.\",\"status\":\"machine\",\"sourceHash\":\"ed2cda112de7a4ed30f82564e1cdb2bfcfc659405950173ac29e9719be355754\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012648806
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Haz doble clic en un dado para tirarlo.","status":"machine","sourceHash":"7d0ec39da1f2a9585089e30dd78916f5a723fc8f0a3a28fee6d2afc529c74661","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648807
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Robar 1 carta","status":"machine","sourceHash":"c2999b0c9ea05cb9a54a03121fa056b40ce6d633c8fa9f5b409bb591458abbf9","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648808
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Al conectar un mando se aplica la orientaci\xF3n
          horizontal, independientemente del ajuste de orientaci\xF3n.\",\"status\":\"machine\",\"sourceHash\":\"8df4d67163c604d52661635fc92534364c06e5d265dfd90ec844ab0d5e9a82f4\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012648809
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Al buscar o filtrar cartas, mostrar solo la primera
          carta con cada nombre y ocultar duplicados.","status":"machine","sourceHash":"fc4ec1f40ab3039b8c5db0594d461a4f83b804beaea90d4c4e210615d30d90b8","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648810
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Unirse a una partida multijugador o crearla.","status":"machine","sourceHash":"f571b526ca0e1e8ff971b9c13b5d4c05d9b3efd4c511c5197c9fcdd5fb10ddf5","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648811
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Ver el nombre de las cartas al pasar el cursor sobre
          ellas.","status":"machine","sourceHash":"202de85a4239cdd4df64fa27c9075a007da04561af753975a10018263b5c0951","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648812
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Las pantallas peque\xF1as pueden usar una resoluci\xF3n
          interna menor; las grandes, una mayor.\",\"status\":\"machine\",\"sourceHash\":\"d5698425fa7bd4d0d7f13b26f57469b9ae5b4d26a4f3b0c6c9491bf15019db5b\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012648813
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Iniciar una partida de un jugador.","status":"machine","sourceHash":"99714e8cff87b05d6b1ca89a94c5cb4c9ad9c06f5642171f7985f68cea1ecd9e","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648814
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"\xBFCu\xE1nto se superponen las cartas al ver
          una pila?\",\"status\":\"machine\",\"sourceHash\":\"f47f0996a3605052dd3d2d9d63e3b2878304dc9c96a4e82414eff57dfef2ad33\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012648815
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Haz doble clic en una pila para abrir el visor de
          pilas.","status":"machine","sourceHash":"2a2df0496de081ed7bf70119a42bd175fa7eaa62ffc41f267de1b00990146fe3","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648816
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Esta ayuda es visible porque est\xE1 activado
          el ajuste \xABAyuda de botones\xBB.\",\"status\":\"machine\",\"sourceHash\":\"78e729f836df4f1c0d523e46d06c87db551e55faa9c052f3cb1a61f803bae8b0\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012648817
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"[Opcional] M\xEDnimo 8 caracteres\",\"status\":\"machine\",\"sourceHash\":\"fa19feff31dd74835415921bdd12db2d349dfe229c0656270351f7c0d2854731\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012648818
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Caras del dado","status":"machine","sourceHash":"d689582b83329630cffe6c0d02ac0cf173ab35edb7d95c3e9f74cab310ded4d5","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648819
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Reverso","status":"machine","sourceHash":"6ee041a18e3631b1a6424286a40233836333d4f4f1c1c0d700b1d218e6978e01","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648820
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"1. Coloca las im\xE1genes de las cartas en una
          carpeta con sus nombres correctos y el TIPO DE ARCHIVO CORRECTO.\\n2. Selecciona
          la carpeta con el bot\xF3n de arriba.\\n3. El nombre del set aparecer\xE1
          arriba y los nombres de sus cartas en este cuadro de texto. Los cambios
          no se guardar\xE1n hasta que confirmes con el bot\xF3n de abajo.\",\"status\":\"machine\",\"sourceHash\":\"c465575d2e9c3d5fef86d3841178ef825a7ac084044755cd22c0785f9562b3e9\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012648821
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Modo desarrollador","status":"machine","sourceHash":"44f9e236c3f6c3df0751d994eba4c0f52d362eae94676cf0f24f4136b005195f","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012648822
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
