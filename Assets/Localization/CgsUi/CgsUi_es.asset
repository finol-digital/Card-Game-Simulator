    - rid: 7133309421012649728
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Contrase\xF1a no aplicada: debe tener entre 8
