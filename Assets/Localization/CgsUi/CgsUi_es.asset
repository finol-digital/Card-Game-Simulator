    - rid: 7133309421012649726
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Introduce {propertyName}...","status":"machine","sourceHash":"109c254381417e310686ee30a604f1819d067fb74f2fe3ea74c883c2bb8b5e31","provenance":{"method":"Codex
