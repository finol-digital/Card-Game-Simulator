    - rid: 7133309421012648799
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Apilar las cartas autom\xE1ticamente cuando se
          superponen.\",\"status\":\"machine\",\"sourceHash\":\"a7595f116049e1f0264212c09aa90d83dae1770c2b39470bfafa1006689d2664\",\"provenance\":{\"method\":\"Codex
