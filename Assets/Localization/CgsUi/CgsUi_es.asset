    - rid: 7133309421012649719
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"\xBFSeguro que quieres eliminar este mazo?\",\"status\":\"machine\",\"sourceHash\":\"347f20c1278aaae9acd9451e441ee0ae713bdce42b065dd312287fd061493b49\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649720
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"\xBFVaciar el editor y crear un mazo nuevo llamado
          Untitled?\",\"status\":\"machine\",\"sourceHash\":\"c29a7c75db1fb086566623e2f6a31bec797631f421ecdfc06a3c3d94578b9caf\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649721
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Ya existe un mazo con ese nombre. \xBFSobrescribirlo?\",\"status\":\"machine\",\"sourceHash\":\"6be133ed4ecde4d06827fe9c73c1bcb979172d7eb7993275c3a087eabb70a282\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649722
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Hay cambios sin guardar. \xBFQuieres guardarlos?\",\"status\":\"machine\",\"sourceHash\":\"1499ac1508b557be531f1d5fdf05122cf3420552cc0a0736ed4deaf982df4611\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649723
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"\xBFVaciar el campo de URL?\",\"status\":\"machine\",\"sourceHash\":\"591de31fdee0f8b614f5393fcd305eea83d7eed9d26fc0cee81787ba28b7319f\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649724
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Descarga otros juegos de cartas antes de eliminarlo.","status":"machine","sourceHash":"b2d173c781680dc5ac3b029e2e0a44385b5abd6f1903ad71c7e9f2997bae53cd","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012649725
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"El juego ya existe. \xBFSobrescribirlo?\",\"status\":\"machine\",\"sourceHash\":\"48421accd40b9d63c148302996fba4872ec4628293514946669c5e333c2b46c5\",\"provenance\":{\"method\":\"Codex
