    - rid: 7133309421012649718
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"\xBFBorrar el texto del mazo?\",\"status\":\"machine\",\"sourceHash\":\"15d1cff53e3cfc2b72d8dffa45a212c66c2c7bc37820f81d7d8a28ce88f4ed0d\",\"provenance\":{\"method\":\"Codex
