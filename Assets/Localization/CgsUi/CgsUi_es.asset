    - rid: 7133309421595918969
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"No se pudo conectar. Para jugar en LAN desde
          el navegador, abre este sitio en otra pesta\xF1a del mismo navegador, crea
          la partida all\xED y selecciona su sala o introduce aqu\xED su ID.\",\"status\":\"machine\",\"sourceHash\":\"c91825ff02019de802dc76b4b8b6cbf333b1d789a4279e88c88f64ab43f0afe7\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595918970
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Es posible que todos los jugadores deban cargar
          manualmente el \xFAltimo .zip del juego. Para obtener ayuda: david@finoldigital.com.\",\"status\":\"machine\",\"sourceHash\":\"45b3c3bdb44974271fd21f4caaeba4c69abfe8adf1a64976e92234b5fe002bae\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595918971
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"\xBFEliminar?\",\"status\":\"machine\",\"sourceHash\":\"c3ec645a954ec285fb51cd44d6fb61a56ec4e7385dc4ab263698aeb0bb88cffa\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595918972
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"No se puede deshacer. \xBFEliminar {name}?\",\"status\":\"machine\",\"sourceHash\":\"293f8a0d6e66c76f2b6157294aac33632b7740525faafdedc3e2766ffd050b1a\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595918973
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
