    - rid: 7133309421595918797
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Importazione di {setName}...","status":"machine","sourceHash":"e6e3a80ef2c9706d54487a68e5b769d5444c580920614b06d9c13518a3e6b2bd","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421595919210
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Seleziona carta: clic sinistro o {move}.\nSposta
          carta: trascina col tasto sinistro o usa {page} con una carta selezionata.\nSposta
          visuale: trascina col tasto centrale o Maiusc+tasto sinistro, oppure usa
          {page}.\nZoom: Ctrl+rotellina, o premi {toggle} per attivare lo zoom con
          {page}.\nRuota: Ctrl+trascina col tasto destro, o premi {toggle} per attivare
          la rotazione con {page}.","status":"machine","sourceHash":"fdafb77ffa0cd274a994e7561ae0efce6b4696dd4ff57f3ded6bf5881f8eaefc","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421595919211
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Seleziona carta: tocca una carta.\\nVisualizza
          carta: tieni premuto per ingrandire.\\nSposta carta: trascina con un dito.\\nSposta
          visuale: trascina l\u2019area di gioco con due dita.\\nZoom: pizzica con
          due dita.\\nRuota: gira con due dita quando la rotazione \xE8 attiva.\",\"status\":\"machine\",\"sourceHash\":\"8cd61d7150b526f4c683276db7e794318884368e3ccf83ec332813dcd398d40d\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421595919212
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Contatore: {value}","status":"machine","sourceHash":"c5675b5a6455c2ca233e27a68e14d77623dae5be8d57ebf69b56a5db48b5bd0b","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421595919213
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
