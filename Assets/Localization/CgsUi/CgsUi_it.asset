    - rid: 7133309421595919214
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Il browser non ha potuto copiare il testo. Riprova
          da una pagina HTTPS in un browser supportato e controlla le autorizzazioni
          degli appunti.","status":"machine","sourceHash":"6cf35631d7b766f365c42ee63a8839394ecbb106db018d6ac42be6587604e6fb","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421595919215
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Condivisione annullata o non completata.","status":"machine","sourceHash":"b2eac93fb69971c61fe3389cb6d8940a42f01383a65bff494661df3a12adea4b","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
