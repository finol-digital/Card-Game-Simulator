    - rid: 7133309421012649654
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Svuotare l\u2019editor e creare un nuovo mazzo
          Untitled?\",\"status\":\"machine\",\"sourceHash\":\"c29a7c75db1fb086566623e2f6a31bec797631f421ecdfc06a3c3d94578b9caf\",\"provenance\":{\"method\":\"Codex
