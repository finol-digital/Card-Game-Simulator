    - rid: 7133309421012649656
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Ci sono modifiche non salvate. Vuoi salvarle?","status":"machine","sourceHash":"1499ac1508b557be531f1d5fdf05122cf3420552cc0a0736ed4deaf982df4611","provenance":{"method":"Codex
