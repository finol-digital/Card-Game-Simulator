    - rid: 7133309420632277962
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Inserisci la propriet\xE0 principale della carta...\",\"status\":\"machine\",\"sourceHash\":\"7d212fbb28361f946ce9b28aa569d64c34119787edeb0981c60cee35cbe17afb\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277963
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"{gameName}\nCopyright di {copyright}, caricato da
          {author}","status":"machine","sourceHash":"66b39d1e2b3baa896345a9b925e6701dd8158ecd950dad0d57045f52c1e89c10","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277964
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Impila automaticamente le carte quando si sovrappongono.","status":"machine","sourceHash":"a7595f116049e1f0264212c09aa90d83dae1770c2b39470bfafa1006689d2664","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277965
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Esplora le carte.","status":"machine","sourceHash":"1102a5d24c129fce0ffad84f9df7deb651d47bee5e47b7eb44faff9c17951cc9","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277966
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Scegli la prima opzione.","status":"machine","sourceHash":"a6e1ffc5e1b18699ca59d2c39910692764055c26a49e5089a7f10e7bb0fdd93f","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277967
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Scegli la seconda opzione.","status":"machine","sourceHash":"c9934b2e58da033c699e7848eb6e5cc7b5f3d4120bece3ae7490eb6d5fc8f069","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277968
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Modifica i mazzi.","status":"machine","sourceHash":"1c4e496051ba46c81de6b6dfbe60746356dd11b0578f6dc35bcf130335d82b02","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277969
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Crea e condividi. Consulta il tutorial sul sito
          CGS.","status":"machine","sourceHash":"e6f0865109bb9538e7584b1016bf1ef56625a7792ef846dd71a6f736bd078cc5","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277970
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Numero di facce di ogni dado alla creazione.","status":"machine","sourceHash":"ed2cda112de7a4ed30f82564e1cdb2bfcfc659405950173ac29e9719be355754","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277971
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Fai doppio clic su un dado per tirarlo.","status":"machine","sourceHash":"7d0ec39da1f2a9585089e30dd78916f5a723fc8f0a3a28fee6d2afc529c74661","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277972
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Pesca 1 carta","status":"machine","sourceHash":"c2999b0c9ea05cb9a54a03121fa056b40ce6d633c8fa9f5b409bb591458abbf9","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277973
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Collegando un controller si attiva l\u2019orientamento
          orizzontale, indipendentemente dall\u2019impostazione dello schermo.\",\"status\":\"machine\",\"sourceHash\":\"8df4d67163c604d52661635fc92534364c06e5d265dfd90ec844ab0d5e9a82f4\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277974
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Nelle ricerche o nei filtri, mostra solo la prima
          carta con ciascun nome e nascondi i duplicati.","status":"machine","sourceHash":"fc4ec1f40ab3039b8c5db0594d461a4f83b804beaea90d4c4e210615d30d90b8","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277975
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Unisciti a una partita multigiocatore o ospitane
          una.","status":"machine","sourceHash":"f571b526ca0e1e8ff971b9c13b5d4c05d9b3efd4c511c5197c9fcdd5fb10ddf5","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277976
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Mostra i nomi delle carte al passaggio del mouse.","status":"machine","sourceHash":"202de85a4239cdd4df64fa27c9075a007da04561af753975a10018263b5c0951","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277977
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Gli schermi piccoli possono usare una risoluzione
          interna pi\xF9 bassa, quelli grandi una pi\xF9 alta.\",\"status\":\"machine\",\"sourceHash\":\"d5698425fa7bd4d0d7f13b26f57469b9ae5b4d26a4f3b0c6c9491bf15019db5b\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277978
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Avvia una partita per giocatore singolo.","status":"machine","sourceHash":"99714e8cff87b05d6b1ca89a94c5cb4c9ad9c06f5642171f7985f68cea1ecd9e","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277979
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Quanto si sovrappongono le carte nella vista delle
          pile?","status":"machine","sourceHash":"f47f0996a3605052dd3d2d9d63e3b2878304dc9c96a4e82414eff57dfef2ad33","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277980
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Fai doppio clic su una pila per aprirne la vista.","status":"machine","sourceHash":"2a2df0496de081ed7bf70119a42bd175fa7eaa62ffc41f267de1b00990146fe3","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277981
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Questo suggerimento \xE8 visibile perch\xE9 \xE8
          attiva l\u2019opzione \u201CSuggerimenti dei pulsanti\u201D.\",\"status\":\"machine\",\"sourceHash\":\"78e729f836df4f1c0d523e46d06c87db551e55faa9c052f3cb1a61f803bae8b0\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277982
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"[Facoltativo] Minimo 8 caratteri","status":"machine","sourceHash":"fa19feff31dd74835415921bdd12db2d349dfe229c0656270351f7c0d2854731","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277983
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Facce del dado","status":"machine","sourceHash":"d689582b83329630cffe6c0d02ac0cf173ab35edb7d95c3e9f74cab310ded4d5","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277984
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Dorso","status":"machine","sourceHash":"6ee041a18e3631b1a6424286a40233836333d4f4f1c1c0d700b1d218e6978e01","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277985
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"1. Metti le immagini delle carte in una cartella
          con i nomi corretti e il TIPO DI FILE CORRETTO.\\n2. Seleziona la cartella
          con il pulsante sopra.\\n3. Il nome del set apparir\xE0 sopra e i nomi
          delle carte in questa casella di testo. Le modifiche verranno salvate solo
          dopo la conferma con il pulsante sotto.\",\"status\":\"machine\",\"sourceHash\":\"c465575d2e9c3d5fef86d3841178ef825a7ac084044755cd22c0785f9562b3e9\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277986
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Modalit\xE0 sviluppatore\",\"status\":\"machine\",\"sourceHash\":\"44f9e236c3f6c3df0751d994eba4c0f52d362eae94676cf0f24f4136b005195f\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277987
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Frequenza dei fotogrammi","status":"machine","sourceHash":"8689ace2c147ba5adf221bc433776c87eb4a2ad1da09da3ea7c205dcf3f3ea7a","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277988
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Senza limite","status":"machine","sourceHash":"ff31476cb532454ba4b12a3a0f2dfdbd7f9520d4c11cd6e881cf6a17cb8af009","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277989
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Orizzontale con controller","status":"machine","sourceHash":"18f867aa10c1c248a32d361080eb77f266f9eb704524bf3369c1b45242910b2c","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277990
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
