    - rid: 7133309421012649655
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Esiste gi\xE0 un mazzo con questo nome. Sovrascriverlo?\",\"status\":\"machine\",\"sourceHash\":\"6be133ed4ecde4d06827fe9c73c1bcb979172d7eb7993275c3a087eabb70a282\",\"provenance\":{\"method\":\"Codex
