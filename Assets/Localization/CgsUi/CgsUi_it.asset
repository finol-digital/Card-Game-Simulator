    - rid: 7133309421012649659
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Il gioco esiste gi\xE0. Sovrascriverlo?\",\"status\":\"machine\",\"sourceHash\":\"48421accd40b9d63c148302996fba4872ec4628293514946669c5e333c2b46c5\",\"provenance\":{\"method\":\"Codex
