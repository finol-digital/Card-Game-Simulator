    - rid: 7133309422095302664
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"//Su ogni riga, inserisci:\\n//<Quantit\xE0>
          <Nome carta>\\n//Per esempio:\\n4 Super Awesome Card\\n3 Less Awesome Card
          I Still Like\\n1 Card That Is Situational\",\"status\":\"machine\",\"sourceHash\":\"fd707523743e8eb5e2bbbcc2fe1138d175e0112b484b6df4dc372eb50fb9694e\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309422095302665
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"### Istruzioni\\n#Su ogni riga, inserisci:\\n#<Quantit\xE0>
          <Nome carta>\\n#Per esempio:\\n4 Super Awesome Card\\n3 Less Awesome Card
          I Still Like\\n1 Card That Is Situational\",\"status\":\"machine\",\"sourceHash\":\"270629432bf2d3111509709bab831e007426cf604edd8bd6db7aec6024377d2e\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309422095302666
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"#Su ogni riga, inserisci <ID carta>\n#Si consiglia
          di copiare e incollare","status":"machine","sourceHash":"43e1f3c13cb204cd956c26e2880c4f90c1fc0f2d74de517cf7479efe1c2e2950","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309422095302667
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"L\u2019immagine di {name} ({id}) \xE8 troppo
          grande. Elimina la carta, comprimi l\u2019immagine con uno strumento come
          https://www.iloveimg.com/compress-image e importala di nuovo.\",\"status\":\"machine\",\"sourceHash\":\"5c57d9f839f6d60e2e3eaa2a3ddb1f230a241406d1e831a3db5883508d228dd6\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309422095302668
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Attenzione: il tipo del file immagine non corrisponde
          a {extension}.","status":"machine","sourceHash":"57913e896fdf4a85f3a3feb37c3e14f33e31bbed9e7335f47a1a3e86ae94e3fe","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309422095302669
