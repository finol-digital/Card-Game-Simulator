        m_CommentText: "{\"text\":\"Choisir la deuxi\xE8me option.\",\"status\":\"machine\",\"sourceHash\":\"c9934b2e58da033c699e7848eb6e5cc7b5f3d4120bece3ae7490eb6d5fc8f069\",\"provenance\":{\"method\":\"Codex
