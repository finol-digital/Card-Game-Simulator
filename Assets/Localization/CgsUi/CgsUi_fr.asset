    - rid: 7133309421012649886
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Ce jeu a d\xE9j\xE0 \xE9t\xE9 t\xE9l\xE9vers\xE9.
          Il n\u2019est actuellement pas possible de modifier les jeux t\xE9l\xE9vers\xE9s.\",\"status\":\"machine\",\"sourceHash\":\"00d9fb8ca4156e366120526ac9a64de9c7a03da29230d0b15ce127c966fb5959\",\"provenance\":{\"method\":\"Codex
