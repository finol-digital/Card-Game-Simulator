    - rid: 7133309421595918734
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Aucune image trouv\xE9e ! Le dossier contient-il
