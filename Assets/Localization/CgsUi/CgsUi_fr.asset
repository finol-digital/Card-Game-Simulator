    - rid: 7133309421012649630
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Effacer le texte du deck ?","status":"machine","sourceHash":"15d1cff53e3cfc2b72d8dffa45a212c66c2c7bc37820f81d7d8a28ce88f4ed0d","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012649631
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Voulez-vous vraiment supprimer ce deck ?","status":"machine","sourceHash":"347f20c1278aaae9acd9451e441ee0ae713bdce42b065dd312287fd061493b49","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012649632
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Vider l\u2019\xE9diteur et cr\xE9er un deck nomm\xE9
          Untitled ?\",\"status\":\"machine\",\"sourceHash\":\"c29a7c75db1fb086566623e2f6a31bec797631f421ecdfc06a3c3d94578b9caf\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649633
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Un deck porte d\xE9j\xE0 ce nom. Le remplacer
          ?\",\"status\":\"machine\",\"sourceHash\":\"6be133ed4ecde4d06827fe9c73c1bcb979172d7eb7993275c3a087eabb70a282\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649634
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Des modifications ne sont pas enregistr\xE9es.
          Voulez-vous les enregistrer ?\",\"status\":\"machine\",\"sourceHash\":\"1499ac1508b557be531f1d5fdf05122cf3420552cc0a0736ed4deaf982df4611\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649635
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Vider le champ URL ?","status":"machine","sourceHash":"591de31fdee0f8b614f5393fcd305eea83d7eed9d26fc0cee81787ba28b7319f","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012649636
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"T\xE9l\xE9chargez d\u2019autres jeux de cartes
          avant de supprimer celui-ci.\",\"status\":\"machine\",\"sourceHash\":\"b2d173c781680dc5ac3b029e2e0a44385b5abd6f1903ad71c7e9f2997bae53cd\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649637
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Ce jeu existe d\xE9j\xE0. Le remplacer ?\",\"status\":\"machine\",\"sourceHash\":\"48421accd40b9d63c148302996fba4872ec4628293514946669c5e333c2b46c5\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649638
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Saisir {propertyName}...","status":"machine","sourceHash":"109c254381417e310686ee30a604f1819d067fb74f2fe3ea74c883c2bb8b5e31","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012649639
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Impossible d\u2019\xE9tablir la connexion multijoueur.\",\"status\":\"machine\",\"sourceHash\":\"d32f8634775ef07ef5fc3b63bd7b8511cf22010839181006eb1d2051c4b7f806\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649640
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Mot de passe non appliqu\xE9 : il doit contenir
          entre 8 et 64 caract\xE8res.\",\"status\":\"machine\",\"sourceHash\":\"986bd7c586c38703c8f9e5e14f089c4a6d0cd7aefa7d0aa5c016dd121a4bd958\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649641
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Erreur : aucun serveur valide n\u2019a \xE9t\xE9
          s\xE9lectionn\xE9 pour rejoindre la partie !\",\"status\":\"machine\",\"sourceHash\":\"679e6a89ce4709dfdc31424139cfa9a4449d5f2cef632ba1454f1b872b628a39\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649642
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Voulez-vous partager le deck de l\u2019h\xF4te
          ?\",\"status\":\"machine\",\"sourceHash\":\"7fbf2fe4f83bf75f3da8ca3d4acf543f0120750b9ec6877bd19c1912ffefb031\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649643
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Revenir au menu principal ?","status":"machine","sourceHash":"12dfd60a9adc4d3b15e9e0e3662e3fb5c38b1e9db19003ef567b06da2dc0fbbc","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309421012649644
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Ce jeu n\u2019a pas d\u2019URL de mise \xE0 jour
          automatique valide !\",\"status\":\"machine\",\"sourceHash\":\"701313cc75ee8466d043f4c6cf0dfeec3d53d21764e6d1d547d4ec83c5ca0dbf\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309421012649645
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Ce jeu n\u2019a pas d\u2019URL pour ses r\xE8gles
