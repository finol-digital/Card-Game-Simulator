    - rid: 7133309420632277754
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Faces du d\xE9\",\"status\":\"machine\",\"sourceHash\":\"d689582b83329630cffe6c0d02ac0cf173ab35edb7d95c3e9f74cab310ded4d5\",\"provenance\":{\"method\":\"Codex
