    - rid: 7133309420632277755
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Dos","status":"machine","sourceHash":"6ee041a18e3631b1a6424286a40233836333d4f4f1c1c0d700b1d218e6978e01","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277756
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"1. Placez les images des cartes dans un dossier
          avec leurs noms corrects et le BON TYPE DE FICHIER.\\n2. S\xE9lectionnez
          le dossier avec le bouton ci-dessus.\\n3. Le nom de l\u2019extension appara\xEEtra
          au-dessus et les noms des cartes dans cette zone de texte. Les modifications
          ne seront enregistr\xE9es qu\u2019apr\xE8s confirmation avec le bouton
          ci-dessous.\",\"status\":\"machine\",\"sourceHash\":\"c465575d2e9c3d5fef86d3841178ef825a7ac084044755cd22c0785f9562b3e9\",\"provenance\":{\"method\":\"Codex
