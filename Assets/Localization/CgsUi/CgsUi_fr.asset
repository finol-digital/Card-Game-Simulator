    - rid: 7133309420632277739
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Modifier les decks.","status":"machine","sourceHash":"1c4e496051ba46c81de6b6dfbe60746356dd11b0578f6dc35bcf130335d82b02","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277740
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Cr\xE9ez et partagez. Consultez le tutoriel sur
          le site CGS.\",\"status\":\"machine\",\"sourceHash\":\"e6f0865109bb9538e7584b1016bf1ef56625a7792ef846dd71a6f736bd078cc5\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277741
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Nombre de faces de chaque d\xE9 \xE0 sa cr\xE9ation.\",\"status\":\"machine\",\"sourceHash\":\"ed2cda112de7a4ed30f82564e1cdb2bfcfc659405950173ac29e9719be355754\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277742
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Double-cliquez sur un d\xE9 pour le lancer.\",\"status\":\"machine\",\"sourceHash\":\"7d0ec39da1f2a9585089e30dd78916f5a723fc8f0a3a28fee6d2afc529c74661\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277743
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Piocher 1 carte","status":"machine","sourceHash":"c2999b0c9ea05cb9a54a03121fa056b40ce6d633c8fa9f5b409bb591458abbf9","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277744
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Brancher une manette active l\u2019orientation
          paysage, quel que soit le r\xE9glage d\u2019orientation.\",\"status\":\"machine\",\"sourceHash\":\"8df4d67163c604d52661635fc92534364c06e5d265dfd90ec844ab0d5e9a82f4\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277745
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Lors de la recherche ou du filtrage, afficher
          uniquement la premi\xE8re carte de chaque nom et masquer les doublons.\",\"status\":\"machine\",\"sourceHash\":\"fc4ec1f40ab3039b8c5db0594d461a4f83b804beaea90d4c4e210615d30d90b8\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277746
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Rejoindre ou h\xE9berger une partie multijoueur.\",\"status\":\"machine\",\"sourceHash\":\"f571b526ca0e1e8ff971b9c13b5d4c05d9b3efd4c511c5197c9fcdd5fb10ddf5\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277747
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Afficher le nom des cartes au survol de la souris.","status":"machine","sourceHash":"202de85a4239cdd4df64fa27c9075a007da04561af753975a10018263b5c0951","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277748
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Les petits \xE9crans peuvent utiliser une r\xE9solution
          interne plus faible, et les grands une plus \xE9lev\xE9e.\",\"status\":\"machine\",\"sourceHash\":\"d5698425fa7bd4d0d7f13b26f57469b9ae5b4d26a4f3b0c6c9491bf15019db5b\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277749
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"D\xE9marrer une partie solo.\",\"status\":\"machine\",\"sourceHash\":\"99714e8cff87b05d6b1ca89a94c5cb4c9ad9c06f5642171f7985f68cea1ecd9e\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277750
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Dans la vue des piles, de combien les cartes se
          chevauchent-elles ?","status":"machine","sourceHash":"f47f0996a3605052dd3d2d9d63e3b2878304dc9c96a4e82414eff57dfef2ad33","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277751
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{"text":"Double-cliquez sur une pile pour ouvrir sa vue.","status":"machine","sourceHash":"2a2df0496de081ed7bf70119a42bd175fa7eaa62ffc41f267de1b00990146fe3","provenance":{"method":"Codex
          contextual machine draft; English context and CGS glossary","date":"2026-10-05"}}'
    - rid: 7133309420632277752
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"Cette infobulle est visible car l\u2019option
          \xAB Infobulles des boutons \xBB est activ\xE9e.\",\"status\":\"machine\",\"sourceHash\":\"78e729f836df4f1c0d523e46d06c87db551e55faa9c052f3cb1a61f803bae8b0\",\"provenance\":{\"method\":\"Codex
          contextual machine draft; English context and CGS glossary\",\"date\":\"2026-10-05\"}}"
    - rid: 7133309420632277753
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "{\"text\":\"[Facultatif] Au moins 8 caract\xE8res\",\"status\":\"machine\",\"sourceHash\":\"fa19feff31dd74835415921bdd12db2d349dfe229c0656270351f7c0d2854731\",\"provenance\":{\"method\":\"Codex
