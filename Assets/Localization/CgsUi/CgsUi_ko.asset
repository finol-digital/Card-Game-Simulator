  - m_Id: 17340964417536
    m_Localized: "//\uAC01 \uC904\uC5D0 \uC785\uB825\uD558\uC138\uC694:\n//<\uC218\uB7C9>
      <\uCE74\uB4DC \uC774\uB984>\n//\uC608\uC2DC:\n4 Super Awesome Card\n3 Less
