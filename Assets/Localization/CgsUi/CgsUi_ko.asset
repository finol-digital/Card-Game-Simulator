      \uC0AC\uC6A9\uD558\uC138\uC694.\n\uD654\uBA74 \uC774\uB3D9: \uAC00\uC6B4\uB370
      \uBC84\uD2BC \uB610\uB294 Shift+\uC67C\uCABD \uBC84\uD2BC\uC73C\uB85C \uB4DC\uB798\uADF8\uD558\uAC70\uB098
      {page}\uC744(\uB97C) \uC0AC\uC6A9\uD558\uC138\uC694.\n\uD655\uB300/\uCD95\uC18C:
      Ctrl+\uB9C8\uC6B0\uC2A4 \uD720 \uB610\uB294 {toggle}\uC744(\uB97C) \uB20C\uB7EC
      {page} \uD655\uB300/\uCD95\uC18C\uB97C \uC804\uD658\uD558\uC138\uC694.\n\uD68C\uC804:
