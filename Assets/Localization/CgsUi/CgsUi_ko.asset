      \uBD99\uC5EC\uB123\uAE30\uB85C \uD655\uC778\uD558\uAC70\uB098 \uB2E4\uC2DC
      \uBCF5\uC0AC\uD558\uC138\uC694."
    m_Metadata:
      m_Items:
      - rid: 7133309421595919178
  - m_Id: 15859771125767
    m_Localized: "\uC774 \uB371\uC758 \uD14D\uC2A4\uD2B8\uB97C \uD074\uB9BD\uBCF4\uB4DC\uC5D0
      \uBCF5\uC0AC\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7133309421595919179
  - m_Id: 15859771125768
    m_Localized: "\uACF5\uC720 \uB300\uC0C1\uC744 \uC120\uD0DD\uD588\uC2B5\uB2C8\uB2E4.
      \uB300\uC0C1\uC5D0\uC11C \uACF5\uC720 \uB610\uB294 \uBCF5\uC0AC \uC5EC\uBD80\uB97C
      \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items:
      - rid: 7133309421595919180
  - m_Id: 15859771125769
    m_Localized: "\uBCF5\uC0AC\uD558\uAC70\uB098 \uACF5\uC720\uD560 \uD14D\uC2A4\uD2B8\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7133309421595919181
  - m_Id: 15859771125770
    m_Localized: "\uACF5\uC720 \uAE30\uB2A5\uC744 \uC5F4\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
    m_Metadata:
      m_Items:
      - rid: 7133309421595919182
  - m_Id: 15859771125771
    m_Localized: "\uACF5\uC720\uD560 \uD30C\uC77C\uC744 \uC900\uBE44\uD558\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
    m_Metadata:
      m_Items:
      - rid: 7133309421595919183
  - m_Id: 15859771125772
    m_Localized: "\uACF5\uC720\uD560 \uD30C\uC77C\uC744 \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC2DC \uB0B4\uBCF4\uB0B8 \uD6C4 \uC2DC\uB3C4\uD558\uC138\uC694."
    m_Metadata:
      m_Items:
      - rid: 7133309421595919184
  - m_Id: 15859771125773
    m_Localized: "\uBC29 ID/IP\uB97C \uD074\uB9BD\uBCF4\uB4DC\uC5D0 \uBCF5\uC0AC\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7133309421595919185
  - m_Id: 15859775320064
    m_Localized: "\uC774 \uD50C\uB7AB\uD3FC\uC5D0\uC11C\uB294 \uACF5\uC720\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7133309421595919186
  - m_Id: 15859775320065
    m_Localized: "\uACF5\uC720 \uCC3D\uC774 \uB2EB\uD614\uC2B5\uB2C8\uB2E4. \uCF58\uD150\uCE20\uAC00
      \uACF5\uC720 \uB610\uB294 \uBCF5\uC0AC\uB418\uC5C8\uB294\uC9C0 \uD655\uC778\uD558\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7133309421595919187
  - m_Id: 15859775320066
    m_Localized: "CGS\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!\nCGS
      \uC6F9\uC0AC\uC774\uD2B8\uC5D0\uC11C \uC0C8 \uC0AC\uC6A9\uC790\uB97C \uC704\uD55C
      \uC548\uB0B4\uC640 \uC790\uB8CC\uB97C \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\nCGS
      \uC6F9\uC0AC\uC774\uD2B8\uB85C \uC774\uB3D9\uD560\uAE4C\uC694?"
    m_Metadata:
      m_Items:
      - rid: 7133309421595919188
  - m_Id: 15859775320067
    m_Localized: "CGS\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!\n\uC774
      \uBAA8\uBC14\uC77C \uBC84\uC804\uC740 CGS PC \uBC84\uC804\uC758 \uBCF4\uC870
      \uC571\uC785\uB2C8\uB2E4. PC \uBC84\uC804\uC740 CGS \uC6F9\uC0AC\uC774\uD2B8\uC5D0\uC11C
      \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\nCGS \uC6F9\uC0AC\uC774\uD2B8\uB85C
      \uC774\uB3D9\uD560\uAE4C\uC694?"
    m_Metadata:
      m_Items:
      - rid: 7133309421595919189
  - m_Id: 17340737925120
    m_Localized: "#\uC5EC\uAE30\uC5D0 \uB371 \uBB38\uC790\uC5F4/\uCF54\uB4DC\uB97C
      \uBD99\uC5EC\uB123\uC73C\uC138\uC694"
