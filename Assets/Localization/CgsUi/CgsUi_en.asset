    m_Localized: '#Paste the deck string/code here'
    m_Metadata:
      m_Items:
      - rid: 7133309421595919339
  - m_Id: 17340964417536
    m_Localized: '//On each line, enter:

      //<Quantity> <Card Name>

      //For
      example:

      4 Super Awesome Card

      3 Less Awesome Card I Still Like

      1
      Card That Is Situational'
    m_Metadata:
      m_Items:
      - rid: 7133309421595919340
  - m_Id: 17340964417537
    m_Localized: '### Instructions

      #On each line, enter:

